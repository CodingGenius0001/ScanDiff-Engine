# Copy to .env and fill in. .env is gitignored.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key, for local dev only. Never commit it or put it in the app.
# The publishable key also works while the scans bucket allows anon reads.
SUPABASE_KEY=your-service-role-key
SUPABASE_BUCKET=scans
# Optional. When set, --list reads scans from this table instead of listing the bucket.
SUPABASE_SCANS_TABLE=scans
# Optional. Bucket for result files such as heat maps (default scandiff). It must be public
# and allow inserts and updates for this key; scans already does.
SUPABASE_RESULTS_BUCKET=scans
# Optional. Turns on the vision check of region crops; without it, classification is geometry only.
VISION_API_KEY=
# Optional. anthropic (the default) is the only provider so far; VISION_MODEL defaults to claude-opus-5-5.
VISION_PROVIDER=anthropic
VISION_MODEL=claude-opus-5-5
