// Copy this file to Secrets.xcconfig. That file is gitignored.
// xcconfig treats // as a comment, so write URL slashes as $(SLASH)$(SLASH).
// The Google client SECRET never goes here. It belongs only in Supabase Auth settings.

SLASH = /

SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = sb_publishable_or_anon_key

GOOGLE_IOS_CLIENT_ID = 1234-abcd.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID = 1234-wxyz.apps.googleusercontent.com
// The iOS client ID with its parts reversed. GoogleSignIn requires it as a URL scheme.
GOOGLE_IOS_URL_SCHEME = com.googleusercontent.apps.1234-abcd

// The app checks /health on ENGINE_URL, then ENGINE_URL_FALLBACK, and diffs on the first that answers.
// Public hosts must be https (App Transport Security); plain http only works on the local network.
// Optional second demo account for the DEBUG "Use demo buyer" button. Create it with
// ios/supabase/demo2.local.sql (gitignored). Leave empty to hide the button.
DEMO2_EMAIL =
DEMO2_PASSWORD =

ENGINE_URL = https:$(SLASH)$(SLASH)engine.example.com
ENGINE_URL_FALLBACK = http:$(SLASH)$(SLASH)172.20.10.2:8000
