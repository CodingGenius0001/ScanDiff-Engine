# Copy to .env.local and fill in. Never commit .env.local.

# Diff data source. Empty URL = mock generated in the browser.
NEXT_PUBLIC_DIFF_API_URL=
# true = ask the engine for its fixed example response (?mock=true)
NEXT_PUBLIC_DIFF_API_MOCK=false
# Up axis of the engine's scan frame: Y (default, ARKit) or Z
NEXT_PUBLIC_DIFF_UP_AXIS=Y

# Supabase (not used by the web app yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth. Server-only: never prefix the secret with NEXT_PUBLIC_.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
