# Copy to .env.local and fill in. Never commit .env.local.

# Diff data source. Empty URL = mock generated in the browser.
NEXT_PUBLIC_DIFF_API_URL=
# true = ask the engine for its fixed example response (?mock=true)
NEXT_PUBLIC_DIFF_API_MOCK=false

# Supabase. Only the publishable key: the app refuses a secret or service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not read by the web app: Google sign-in goes through Supabase Auth, which holds the secret.
# Never prefix the secret with NEXT_PUBLIC_.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional. Adds a "Use the demo account" button on /login. This ends up in the browser bundle,
# so only use a throwaway demo account (ios/supabase/seed.sql creates one).
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
